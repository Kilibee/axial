cask "axial" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "@URL@"
  name "Axial"
  desc "Native SpaceMouse and SpaceExplorer driver"
  homepage "https://github.com/consi/axial"

  depends_on macos: :ventura

  pkg "Axial-#{version}-universal.pkg"

  preflight_steps do
    run "/bin/bash", args: ["-c", <<~'SHELL'], sudo: true
@INSTALL_GUARD@
      axial_check /
    SHELL
  end

  uninstall_preflight_steps do
    run "/bin/bash", args: ["-c", <<~'SHELL'], sudo: true
@INSTALL_GUARD@
      axial_check /
    SHELL
  end

  uninstall pkgutil: @RECEIPTS@

  # Zap runs after package removal, so use the helper from the cached package.
  zap script: { executable: "/bin/bash", args: ["-c", <<~'SHELL', "axial-zap", "#{staged_path}/Axial-#{version}-universal.pkg"], sudo: true }
    set -euo pipefail
    [[ $(/usr/bin/shasum -a 256 "$1" | /usr/bin/awk '{print $1}') == '@SHA256@' ]]
    temporary=$(/usr/bin/mktemp -d)
    trap '/bin/rm -rf "$temporary"' EXIT
    /usr/sbin/pkgutil --expand-full "$1" "$temporary/package"
    app=$(/usr/bin/find "$temporary/package" -type d -path '*/Applications/Axial.app')
    [[ -n "$app" && "$app" != *$'\n'* ]]
    /usr/bin/codesign --verify --deep --strict "$app"
    "$app/Contents/Library/Helpers/axial-web-setup" --uninstall
  SHELL

  caveats <<~EOS
    Uninstall the 3Dconnexion driver and quit Axial and CAD apps before installing or upgrading.
    This installer requires administrator access. Binaries are ad-hoc signed; the package is not notarized.
    macOS may require approval in Privacy & Security before Axial can run.
    Open /Applications/Axial.app after installation and grant Accessibility access for shortcuts.
    For web navigation, approve Set Up in Axial's Service & diagnostics pane.
    Disable Start at login and quit Axial before uninstalling. Saved profiles are retained.
    Use brew uninstall --zap to also remove web navigation setup; ordinary uninstall preserves it.
  EOS
end
