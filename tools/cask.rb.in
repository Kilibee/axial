cask "axial" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "@URL@"
  name "Axial"
  desc "Native SpaceMouse and SpaceExplorer driver"
  homepage "https://github.com/consi/axial"

  depends_on macos: :ventura

  pkg "Axial-#{version}-universal.pkg"

  uninstall_preflight_steps do
    run "/bin/bash", args: ["-c", <<~SHELL]
      set -euo pipefail
      for name in Axial 3DconnexionClient 3DconnexionNavlib; do
        if [[ "$name" == Axial ]]; then
          bundle=/Applications/Axial.app
          plist="$bundle/Contents/Info.plist"
        else
          bundle="/Library/Frameworks/$name.framework"
          plist="$bundle/Resources/Info.plist"
        fi
        if [[ -e "$bundle" || -L "$bundle" ]]; then
          identity=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$plist")
          [[ "$identity" == "pro.jest.$name" ]] || {
            echo "Refusing to remove non-Axial bundle: $bundle" >&2
            exit 1
          }
        fi
      done
    SHELL
  end

  uninstall script:  { executable: "/Applications/Axial.app/Contents/Library/Helpers/axial-web-setup", args: ["--uninstall"], sudo: true },
            quit:    "pro.jest.Axial",
            pkgutil: @RECEIPTS@

  caveats <<~EOS
    Uninstall the 3Dconnexion driver and quit Axial and CAD apps before installing or upgrading.
    This installer requires administrator access. Binaries are ad-hoc signed; the package is not notarized.
    macOS may require approval in Privacy & Security before Axial can run.
    Open /Applications/Axial.app after installation and grant Accessibility access for shortcuts.
    For web navigation, approve Set Up in Axial's Service & diagnostics pane.
    Disable Start at login and quit Axial before uninstalling. Saved profiles are retained.
  EOS
end
